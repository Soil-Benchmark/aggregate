# Mapbox token (client-side: basemap + address geocoding in the Add Farm form)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google Cloud Storage — persists user-submitted groups (groups.json) and
# farms (farms.json). The /api/groups and /api/farms routes return 503 until
# GCS_BUCKET is set.
GCS_BUCKET=
# Optional project id (otherwise inferred from the credentials)
GCS_PROJECT_ID=
# Credentials — provide ONE of:
#   - GOOGLE_APPLICATION_CREDENTIALS: path to a service-account key file (ADC)
#   - GCS_SERVICE_ACCOUNT_KEY: the service-account JSON, inline (single line)
GCS_SERVICE_ACCOUNT_KEY=
